graph TB
    subgraph "Maquina del desarrollador o servidor de demo"
        subgraph "Docker Compose Network: default"
            DC1[medscribe-mysql<br/>mysql:8.0<br/>Vol: mysql_data<br/>Healthcheck: mysqladmin ping]
            DC2[medscribe-gateway<br/>eclipse-temurin:17-jre-alpine<br/>JAR de Spring Boot]
            DC3[medscribe-servicio-ia<br/>python:3.12-slim<br/>uvicorn]
            DC4[medscribe-cliente-web<br/>nginx:alpine<br/>Build estatico de Angular]
        end

        subgraph "Puertos expuestos al host"
            P1[3307: MySQL]
            P2[5000: Gateway Java]
            P3[8000: Servicio IA]
            P4[3000: Frontend Angular]
        end
    end

    subgraph "Internet"
        Browser[Navegador del usuario]
        APIs[APIs externas:<br/>Groq, HF, Mistral,<br/>Deepgram, etc.]
    end

    Browser -->|http://localhost:3000| P4
    P4 --> DC4
    DC4 -->|nginx proxy_pass /api| DC2
